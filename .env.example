# Copy this file to server/.env and fill in real values.
# The app runs fully in DEMO MODE with mock providers if these are left blank/placeholder.

# --- Database ---
DATABASE_URL="postgresql://broszeit:broszeit@localhost:5432/broszeit"

# --- App ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
JWT_SECRET=change-me-in-production

# --- WhatsApp Cloud API (Meta) ---
# Leave empty to run the WhatsApp integration in DEMO MODE (mock provider, no real messages sent).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- OpenAI ---
# Leave empty to run the AI assistant in DEMO MODE (mock provider, canned/deterministic suggestions).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

# --- Agenten-Terminal (Samantha + Team) ---
# Leave AGENTS_INBOUND_TOKEN empty to run the terminal in DEMO MODE (simulated agents).
# Your agents post status/activity/questions/replies to POST /api/agents/inbound with "Authorization: Bearer <AGENTS_INBOUND_TOKEN>".
AGENTS_INBOUND_TOKEN=
# Optional: sent as "Authorization: Bearer <token>" when the terminal forwards your messages to an agent's webhookUrl.
AGENTS_OUTBOUND_TOKEN=
# Optional: agents to register at startup (they can also register themselves via the inbound endpoint).
# AGENTS_REGISTRY=[{"id":"samantha","name":"Samantha","role":"Leitung","isLead":true,"webhookUrl":"https://n8n.example.com/webhook/samantha"}]
AGENTS_REGISTRY=

# --- Data retention (days) ---
AI_CONTENT_RETENTION_DAYS=180
WEBHOOK_RAW_PAYLOAD_RETENTION_DAYS=30
